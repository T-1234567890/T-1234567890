{
  "type": "module",
  "scripts": {
    "build": "npm run build:app && npm run build:pixel-background && npm run build:blog && npm run build:legal-notices",
    "build:app": "esbuild src/main.jsx --bundle --format=esm --jsx=automatic --minify --outfile=js/react-app.js",
    "build:pixel-background": "esbuild src/pixel-blast-background.jsx --bundle --format=esm --jsx=automatic --minify --outfile=js/pixel-blast-background.js",
    "build:blog": "esbuild blog/post.js --bundle --format=esm --minify --outfile=blog/post-renderer.js",
    "build:legal-notices": "esbuild legal-notices/legal-notices.js --bundle --format=esm --minify --outfile=legal-notices/legal-notices-renderer.js",
    "dev": "npm run build:blog && npm run build:legal-notices && npm run build:pixel-background && esbuild src/main.jsx --bundle --format=esm --jsx=automatic --sourcemap --outfile=js/react-app.js --servedir=. --serve=5173",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "motion": "^13.1.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.9.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
